{
  "name": "slipstream-mcp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:runtime": "node scripts/build-health-contract.mjs",
    "test:runtime": "vitest run --config vitest.worker.config.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "jose": "6.2.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.160.0"
  },
  "overrides": {
    "agents@0.24.0": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "@modelcontextprotocol/client": "$@modelcontextprotocol/client"
    },
    "express@5.2.1": {
      "body-parser": "2.4.0"
    },
    "ajv@8.20.0": {
      "fast-uri": "3.1.9"
    },
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "hono": "4.13.18",
    "vite": "8.1.6"
  }
}

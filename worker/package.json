{
  "name": "slipstream-mcp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:runtime": "node scripts/build-health-contract.mjs",
    "test:runtime": "vitest run --config vitest.worker.config.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.26.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "agents@0.24.0": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "@modelcontextprotocol/client": "$@modelcontextprotocol/client"
    },
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}

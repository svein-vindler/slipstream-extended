{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slipstream-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{ "name": "REFRESH_COORDINATOR", "class_name": "RefreshCoordinator" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FitnessMCP"] },
		{ "tag": "v2", "new_sqlite_classes": ["RefreshCoordinator"] },
		{ "tag": "v3", "deleted_classes": ["FitnessMCP"] }
	],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": false },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"ratelimits": [
		{
			"name": "MCP_RATE_LIMITER",
			"namespace_id": "3772749551",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"vars": {
		"GITHUB_REFRESH_WORKFLOW": "refresh.yml",
		"GITHUB_REFRESH_REF": "main",
		"REFRESH_COOLDOWN_MINUTES": "30",
		"MCP_WRITE_DAILY_LIMIT": "60"
	},
	"r2_buckets": [
		{
			"bucket_name": "slipstream-data",
			"binding": "SLIPSTREAM_DATA"
		}
	]
}

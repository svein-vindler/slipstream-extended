# Copy this file to .env (which is gitignored) and fill in your own values.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slipstream-data
GARMINTOKENS_FILE=garmin_tokens.local.txt

# Optional stricter limits. Defaults remain 5 GiB, 100,000 objects,
# 250 writes and 512 MiB uploaded per phase/cycle.
# R2_MAX_BUCKET_BYTES=5368709120
# R2_MAX_BUCKET_OBJECTS=100000
# R2_MAX_WRITES_PER_RUN=250
# R2_MAX_WRITE_BYTES_PER_RUN=536870912
